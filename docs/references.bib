@article {Singhal2026.07.13.738221,
	author = {Singhal, Anupriya and Ryan, Kate and Rose, Samuel A. and Styers, Hannah C. and Kim, Jung Yun and Pasnuri, Nikhita and Moore, Ashlyn and Meza-Llamosas, Jose and Chen, Emma and Adams, Josephine and Nandula, Ananya and Sharma, Roshan and Li, Zhuxuan and Nawy, Tal and Yan, Yan and Tezcan, Nuray and Basturk, Olca and Sherman, Mara H. and Pe{\textquoteright}er, Dana and Tammela, Tuomas},
	title = {The basal cell state maintains pancreatic cancers by controlling an immunosuppressive circuit},
	elocation-id = {2026.07.13.738221},
	year = {2026},
	doi = {10.64898/2026.07.13.738221},
	publisher = {Cold Spring Harbor Laboratory},
	abstract = {Intra-tumoral heterogeneity is a cardinal feature of solid tumors, yet how distinct cancer cell states functionally contribute to malignant and stromal diversity in situ remains poorly understood. Using mouse models to lineage-trace or genetically ablate the two predominant cancer cell states in autochthonous pancreatic ductal adenocarcinoma (PDAC), we discover that basal cancer cells are highly plastic, whereas classical cancer cells exhibit limited plasticity. Strikingly, ablation of the basal, but not the classical, state induced rapid and durable tumor collapse, driven by loss of immunosuppressive cancer-associated fibroblasts, macrophage repolarization, and reprogramming of the tumor cytokine milieu, culminating in tumor destruction by cytotoxic lymphocytes. Knockout of a single cytokine, GM-CSF, specifically in basal cells recapitulated macrophage repolarization and lymphocyte recruitment observed upon basal state ablation and shrank tumors. These results reveal the basal cell state controls an immunosuppressive cell circuit critical for PDAC maintenance, motivating therapeutic targeting of the basal cells.Competing Interest StatementT.T. is a scientific advisor with equity interests in Lime Therapeutics. His spouse is an employee of and has equity in Recursion Pharmaceuticals. The Tammela laboratory receives funding from Ono Pharma, although this funding did not directly support this work.National Cancer Institute, https://ror.org/040gcmg81, CA184746, CA244911, CA283378, CA274492, CA08748, CA08748Cancer Research Institute, https://ror.org/02f3xk561, CRI5063American Association For Cancer Research, https://ror.org/02fnpv153Wrobel Family FoundationHoward Hughes Medical Institute, https://ror.org/006w34k90Josie Robertson FoundationBreak Through CancerThe Mark Foundation for Cancer Research, https://ror.org/00v7th354},
	URL = {https://www.biorxiv.org/content/early/2026/07/14/2026.07.13.738221},
	eprint = {https://www.biorxiv.org/content/early/2026/07/14/2026.07.13.738221.full.pdf},
	journal = {bioRxiv}
}
